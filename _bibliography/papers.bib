@inproceedings{astudillo2024preferentialmultiobjectivebayesianoptimization,
  title={Polycatenated Architected Materials for Adaptive and Autonomous Robotic Systems},
  author={Nadarajah, S and Zhou, W and Nkala, T and Wan, K and Daraio, C},
  booktitle={Materials Research Society},
  year={2025},
  preview={levelset.png},
  pdf={https://eppro01.ativ.me/appinfo.php?page=Session&project=MRSFALLLITE25&id=4375592&server=eppro01.ativ.me},
  abstract={Advancing soft robotics and autonomous adaptive systems necessitates multifunctional materials with engineered capabilities for tunable mechanical response, efficient energy dissipation, and persistent structural robustness when subjected to complex and variable operational demands. Across the spectrum of available material systems—from architected materials to discrete assemblies—persistent challenges such as static configurations, limited mechanical adaptability, and insufficient energy dissipation collectively curtail their performance in applications requiring distributed control and embodied intelligence. These limitations fundamentally arise from the inability of most material architectures to unify structural cohesion with dynamic reconfigurability within a single system.
Addressing these constraints, we introduce polycatenated architected materials (PAMs), comprising discrete, topologically interlocked structural units. PAMs uniquely integrate the structural soundness of periodic lattices with the configurational adaptability inherent in granular systems. Under mechanical stimuli, PAMs undergo reversible structural transformations, transitioning from compliant, fluid-like states to rigid, load-bearing configurations via particle rearrangements and jamming mechanisms. Crucially, this adaptive behavior does not depend on intrinsic material compliance, allowing PAMs to achieve complex shape conformity even when composed of relatively stiff constituents.
Rheological characterization reveals that PAMs display distinct non-Newtonian behavior, most notably a transition from shear- thinning to shear-thickening regimes—a feature seldom encountered in architected materials. The emergence of a prominent shear-thickening response, coupled with the dynamic redistribution of forces through transient force chains, unveils new possibilities for energy dissipation and adaptive impact mitigation. Under dynamic loading, the discrete and interlocked architecture of PAMs further demonstrates compelling potential for effective force attenuation and vibration damping, pointing to broader opportunities in the design of robust, reconfigurable material systems.
By embedding reconfigurability, mechanical programmability, and passive control within their architecture, PAMs redefine how multifunctionality and adaptability emerge directly from material structure. Their distinctive combination of resilience, tunability, and conformability establishes PAMs as an enabling platform for next-generation compliant joints, reconfigurable grippers, and protective skins in soft and autonomous robotic systems. More broadly, the inherent versatility and durability of PAMs offer significant potential across diverse engineering fields requiring robust and intelligent mechanical response.},
  selected={true},
}

@inproceedings{astudillo2024preferentialmultiobjectivebayesianoptimization,
  title={Personalized Acupoint Massage Method for Rehabilitation in Patients with Facial Paralysis},
  author={Wan, K},
  booktitle={Society for Neuroscience, Housner Fellowship, Oral Presentation},
  year={2025},
  preview={levelset.png},
  abstract={Facial paralysis is an increasingly prevalent condition characterized by the loss of voluntary muscle activity mainly on one side of the face, resulting from various causes such as Bell's palsy, viral infections, stroke, and trauma. This condition manifests as asymmetry in the mouth and eyes, often causing significant cosmetic and functional impairments, including oral dysfunction, muscle contractures, nasal obstruction, and synkinesis. The psychological and neurological impact on patients can also be profound, affecting interpersonal relationships.Recent advancements in personalized rehabilitation have highlighted the effectiveness of facial acupoint massage, which significantly enhances clinical outcomes by improving recovery times and reducing complications. However, research on the precise localization of massage acupoints tailored to the individual's condition and rehabilitation stage is limited, leading to a gap in personalized treatment strategies.This study aims to address these gaps by developing a personalized assisted rehabilitation method based on acupoint massage for patients with facial paralysis. Utilizing traditional Chinese medicine principles, we analyze the relationship between specific facial acupoints and clinical symptoms of facial paralysis. By targeting specific acupoints, the massage aims to restore muscle and nerve function on the affected side. Additionally, we employ image technology and a transformation matrix method for six primary massage acupoints (Yangbai, Zanzhu, Sibai, Yingxiang, Jiache, and Dicang) to achieve precise acupoint localization relative to key facial contours (eyes, nose, mouth) on the affected side. Our findings indicate changes in main acupoint positions such as the Sibai and Dicang, necessitating tailored massage methods. For instance, a case study involving a photograph of an adult male with right facial paralysis shows rotational deviations of the right eye and the corner of the mouth counterclockwise by 10° and 15°, respectively. Thus, the research reveals that in massage rehabilitation for facial paralysis patients, the positions of the Sibai and Dicang acupoints shift horizontally by 4.5mm and 1mm, and vertically by 0.4mm and 8.1mm, respectively. By comparing the shape similarity between healthy and affected faces, we also propose a segmented massage strategy to adjust the intensity and frequency of massages at different stages of rehabilitation. Our approach provides targeted training in facial acupoint massage rehabilitation. It not only offers clinical guidance for the treatment of facial paralysis but also helps minimize the sequelae associated with the condition.},
  selected={true},
}
